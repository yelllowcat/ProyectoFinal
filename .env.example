# UNIRED - Configuración de Variables de Entorno
# Copia este archivo como .env y edita los valores correspondientes para tu entorno local o servidor.

APP_NAME=UNIRED
APP_ENV=local
APP_URL=http://localhost:8000

# Conexión a Base de Datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unired_DB
DB_USER=root
DB_PASS=
